# =============================================================================
# DentalPilot AI 口腔影像分析工具 - 环境变量配置模板
# =============================================================================
# 使用方法：
# 1. 复制本文件为 .env
#    Windows CMD:    copy .env.example .env
#    PowerShell:     Copy-Item .env.example .env
#    Linux/Mac:      cp .env.example .env
#
# 2. 填入你的真实 API Key
#
# 3. .env 文件已经被 .gitignore 排除，不会被提交到 GitHub
# =============================================================================

# -----------------------------------------------------------------------------
# 大模型 API 配置（至少填一个）
# -----------------------------------------------------------------------------

# Minimax M3（推荐：你已订阅）
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# DeepSeek（备选：便宜好用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VL_MODEL=deepseek-vl

# 通义千问 DashScope（备选：国内稳定）
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus

# 智谱 GLM（备选：性价比高）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VL_MODEL=glm-4v-plus

# -----------------------------------------------------------------------------
# 模型权重路径（本地部署时用）
# -----------------------------------------------------------------------------

# YOLOv8 牙齿检测模型
YOLO_DETECT_MODEL=./models/yolov8n_teeth.pt
# YOLOv8 病灶识别模型
YOLO_DISEASE_MODEL=./models/yolov8n_disease.pt
# DentalSegmentator 权重
DENTAL_SEG_MODEL=./models/dental_segmentator.pt

# -----------------------------------------------------------------------------
# 服务配置
# -----------------------------------------------------------------------------

# Gradio 服务端口
GRADIO_PORT=7860
GRADIO_HOST=127.0.0.1
# 是否对外公开（演示时设为 True）
GRADIO_SHARE=False

# API 代理端口（可选）
PROXY_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 业务配置
# -----------------------------------------------------------------------------

# 客户标识（部署到客户环境时修改）
CLIENT_NAME=default
# 部署版本
APP_VERSION=0.1.0
